skelGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
skelGui.DisplayOrder = 6
pcall(function() skelGui.Parent = game.CoreGui end)

local Skeletons = {}
local LINE_WIDTH = 2

local R15Bones = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}
}
local R6Bones = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}

local function MakeSkelLine()
    local line = Instance.new("Frame")
    line.BackgroundColor3 = getAccentColor()
    line.BorderSizePixel = 0
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.Visible = false
    line.ZIndex = 10
    line.Parent = skelGui
    return line
end

local function CreateSkeleton(player, character)
    if player == Player then return end
    if not character or not character.Parent then return end
    if Skeletons[player] and Skeletons[player].Character == character then return end
    if Skeletons[player] then
        for _, line in ipairs(Skeletons[player].Lines) do
            pcall(function() line:Destroy() end)
        end
        Skeletons[player] = nil
    end
    local hum = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 2)
    if not hum then return end
    local bones = (hum.RigType == Enum.HumanoidRigType.R15) and R15Bones or R6Bones
    local lines = {}
    for _ = 1, #bones do table.insert(lines, MakeSkelLine()) end
    Skeletons[player] = {Character=character, Lines=lines, Bones=bones}
end

local function RemoveSkeleton(player)
    if Skeletons[player] then
        for _, line in ipairs(Skeletons[player].Lines) do
            pcall(function() line:Destroy() end)
        end
        Skeletons[player] = nil
    end
end

local function ApplySkeletonEsp()
    if settings.skeletonEspEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Player and p.Character then CreateSkeleton(p, p.Character) end
        end
    else
        for p in pairs(Skeletons) do RemoveSkeleton(p) end
    end
end

-- ===================== MM2 CHAMS =====================
local mm2Folder = Instance.new("Folder")
mm2Folder.Name = "MonCombat_MM2Chams"
mm2Folder.Parent = workspace

local MURDER_KW  = {"murder","knife","killer"}
local SHERIFF_KW = {"sheriff","gun","revolver","deputy"}

local function matchAny(s, list)
    s = s:lower()
    for _, kw in ipairs(list) do
        if s:find(kw, 1, true) then return true end
    end
    return false
end

local function MM2GetRole(plr)
    if plr == Player then return "You", Color3.fromRGB(255, 255, 255) end
    for _, cont in ipairs({plr.Character, plr:FindFirstChild("Backpack")}) do
        if cont then
            for _, t in ipairs(cont:GetChildren()) do
                if t:IsA("Tool") then
                    if matchAny(t.Name, MURDER_KW)  then return "Murderer", Color3.fromRGB(255, 0, 0) end
                    if matchAny(t.Name, SHERIFF_KW) then return "Sheriff",  Color3.fromRGB(0, 120, 255) end
                end
            end
        end
    end
    local pg = plr:FindFirstChild("PlayerGui")
    if pg then
        for _, o in ipairs(pg:GetDescendants()) do
            if matchAny(o.Name, MURDER_KW)  then return "Murderer", Color3.fromRGB(255, 0, 0) end
            if matchAny(o.Name, SHERIFF_KW) then return "Sheriff",  Color3.fromRGB(0, 120, 255) end
        end
    end
    return "Innocent", Color3.fromRGB(0, 255, 0)
end

local function MM2Clear()
    for _, c in ipairs(mm2Folder:GetChildren()) do c:Destroy() end
end

local function MM2Build()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == Player then continue end
        local char = plr.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then continue end

        local role, color = MM2GetRole(plr)

        local hl = Instance.new("Highlight")
        hl.Adornee = char
        hl.FillColor = color
        hl.FillTransparency = 0.5
        hl.OutlineColor = color
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = mm2Folder

        local bill = Instance.new("BillboardGui")
        bill.Adornee = hrp
        bill.Size = UDim2.new(0, 140, 0, 36)
        bill.StudsOffset = Vector3.new(0, 3, 0)
        bill.AlwaysOnTop = true
        bill.Parent = mm2Folder

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = role
        lbl.TextColor3 = color
        lbl.TextStrokeTransparency = 0
        lbl.TextScaled = true
        lbl.Parent = bill
    end
end

