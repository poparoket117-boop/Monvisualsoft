-- ===================== LOOPS =====================
RunService.RenderStepped:Connect(function()
    if settings.boxEspEnabled then
        for player, data in pairs(Boxes) do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if not character or not humanoid or humanoid.Health <= 0 or not root then
                data.Box.Visible = false
                continue
            end
            local HEIGHT, WIDTH = 6, 3.2
            local topWorld = root.Position + Vector3.new(0, HEIGHT / 2, 0)
            local bottomWorld = root.Position - Vector3.new(0, HEIGHT / 2, 0)
            local top = Camera:WorldToViewportPoint(topWorld)
            local bottom = Camera:WorldToViewportPoint(bottomWorld)
            if top.Z <= 0 or bottom.Z <= 0 then data.Box.Visible = false continue end
            local screenHeight = math.abs(top.Y - bottom.Y)
            local screenWidth = screenHeight * (WIDTH / HEIGHT)
            local centerX = (top.X + bottom.X) / 2
            local centerY = (top.Y + bottom.Y) / 2
            data.Box.Position = UDim2.fromOffset(centerX - screenWidth / 2, centerY - screenHeight / 2)
            data.Box.Size = UDim2.fromOffset(screenWidth, screenHeight)
            data.Top.Position = UDim2.fromOffset(0, 0)
            data.Top.Size = UDim2.new(1, 0, 0, BOX_THICKNESS)
            data.Bottom.Position = UDim2.new(0, 0, 1, -BOX_THICKNESS)
            data.Bottom.Size = UDim2.new(1, 0, 0, BOX_THICKNESS)
            data.Left.Position = UDim2.fromOffset(0, 0)
            data.Left.Size = UDim2.new(0, BOX_THICKNESS, 1, 0)
            data.Right.Position = UDim2.new(1, -BOX_THICKNESS, 0, 0)
            data.Right.Size = UDim2.new(0, BOX_THICKNESS, 1, 0)
            local accent = getAccentColor()
            data.Top.BackgroundColor3 = accent
            data.Bottom.BackgroundColor3 = accent
            data.Left.BackgroundColor3 = accent
            data.Right.BackgroundColor3 = accent
            data.Box.Visible = true
        end
    else
        for _, data in pairs(Boxes) do data.Box.Visible = false end
    end

    if settings.skeletonEspEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Player and p.Character and p.Character.Parent then
                if not Skeletons[p] or Skeletons[p].Character ~= p.Character then
                    CreateSkeleton(p, p.Character)
                end
            end
        end
        for player, data in pairs(Skeletons) do
            local character = data.Character
            if not character or not character.Parent then
                RemoveSkeleton(player)
                continue
            end
            for i, bone in ipairs(data.Bones) do
                local part1 = character:FindFirstChild(bone[1])
                local part2 = character:FindFirstChild(bone[2])
                local line = data.Lines[i]
                if not part1 or not part2 then
                    line.Visible = false
                else
                    local pos1 = Camera:WorldToViewportPoint(part1.Position)
                    local pos2 = Camera:WorldToViewportPoint(part2.Position)
                    if pos1.Z <= 0 or pos2.Z <= 0 then
                        line.Visible = false
                    else
                        local v1 = Vector2.new(pos1.X, pos1.Y)
                        local v2 = Vector2.new(pos2.X, pos2.Y)
                        local diff = v2 - v1
                        local length = diff.Magnitude
                        if length < 1 then
                            line.Visible = false
                        else
                            local mid = (v1 + v2) / 2
                            line.Position = UDim2.fromOffset(mid.X, mid.Y)
                            line.Size = UDim2.fromOffset(length, LINE_WIDTH)
                            line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
                            line.BackgroundColor3 = getAccentColor()
                            line.Visible = true
                        end
                    end
                end
            end
        end
    else
        for _, data in pairs(Skeletons) do
            for _, line in ipairs(data.Lines) do line.Visible = false end
        end
    end
end)

