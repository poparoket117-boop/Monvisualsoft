local oc = Instance.new("UICorner", OpenBtn)
oc.CornerRadius = UDim.new(0, 15)

local SpeakerLabel = Instance.new("TextLabel", OpenBtn)
SpeakerLabel.Size = UDim2.new(1, -12, 1, 0)
SpeakerLabel.Position = UDim2.new(0, 6, 0, 0)
SpeakerLabel.BackgroundTransparency = 1
SpeakerLabel.Text = "MONVISUAL  FPS: " .. fpsValue
SpeakerLabel.TextColor3 = WHITE
SpeakerLabel.TextSize = 12
SpeakerLabel.Font = Enum.Font.GothamBold
SpeakerLabel.TextXAlignment = Enum.TextXAlignment.Center
SpeakerLabel.TextTruncate = Enum.TextTruncate.AtEnd
SpeakerLabel.TextStrokeTransparency = 1
SpeakerLabel.ZIndex = 3

local wasRadioPlaying = false
RunService.RenderStepped:Connect(function(dt)
    if radioIsPlaying and radioSound and radioSongs[radioCurrentIndex] then
        SpeakerLabel.Text = "♪ " .. radioSongs[radioCurrentIndex].name
        SpeakerLabel.TextSize = 14
    else
        SpeakerLabel.Text = "MONVISUAL  FPS: " .. fpsValue
        SpeakerLabel.TextSize = 12
    end

    local nowPlaying = radioIsPlaying and radioSound ~= nil
    if nowPlaying ~= wasRadioPlaying then
        wasRadioPlaying = nowPlaying
        local targetSize
        if nowPlaying then
            targetSize = UDim2.new(0, 165, 0, 30)
        else
            targetSize = UDim2.new(0, 200, 0, 30)
        end
        TweenService:Create(OpenBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = targetSize
        }):Play()
    end
end)

local speakerAnimating = false

local function animateSpeaker(show)
    if speakerAnimating then return end
    speakerAnimating = true

    local targetY
    if show then
        targetY = -0.08
    else
        targetY = -0.03
    end

    local tween = TweenService:Create(OpenBtn, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, targetY, 0)
    })
    tween:Play()

    tween.Completed:Connect(function()
        speakerAnimating = false
    end)
end

_G.Monvisual_AnimateSpeaker = animateSpeaker

OpenBtn.MouseButton1Click:Connect(function()
    local show = not Main.Visible
    toggleMenu(show)
    animateSpeaker(show)
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        local show = not Main.Visible
        toggleMenu(show)
        animateSpeaker(show)
    end
end)

