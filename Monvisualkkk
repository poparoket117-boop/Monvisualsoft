        f.BackgroundColor3 = getAccentColor()
        f.BorderSizePixel = 0
        f.Parent = box
        return f
    end

    local top = makeSide()
    local bottom = makeSide()
    local left = makeSide()
    local right = makeSide()

    Boxes[player] = {
        Box = box,
        Top = top,
        Bottom = bottom,
        Left = left,
        Right = right
    }
end

local function RemoveBox(player)
    if Boxes[player] then
        pcall(function() Boxes[player].Box:Destroy() end)
        Boxes[player] = nil
