local Boxes = {}
local BOX_THICKNESS = 1.5

local function CreateBox(player)
    if player == Player then return end
    if Boxes[player] then return end
    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = boxGui
    local function makeSide()
        local f = Instance.new("Frame")
        f.BackgroundColor3 = getAccentColor()
        f.BorderSizePixel = 0
        f.Parent = box
        return f
    end
    Boxes[player] = {Box=box, Top=makeSide(), Bottom=makeSide(), Left=makeSide(), Right=makeSide()}
end

local function RemoveBox(player)
    if Boxes[player] then
        pcall(function() Boxes[player].Box:Destroy() end)
        Boxes[player] = nil
    end
end

local function ApplyBoxEsp()
    if settings.boxEspEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Player then CreateBox(p) end
        end
    else
        for p in pairs(Boxes) do RemoveBox(p) end
    end
