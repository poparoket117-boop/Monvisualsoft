local function SaveConfig()
    local data = {}
    for k, v in pairs(settings) do
        if typeof(v) == "Color3" then data[k] = {v.R, v.G, v.B}
        else data[k] = v end
    end
    data.themeHue = themeHue
    data.themeIsClear = themeIsClear
    data.radioVolume = radioVolume
    data.radioLoop = radioLoop
    _writefile(CONFIG_FILE, HttpService:JSONEncode(data))
end

local function LoadConfig()
    local data = _readfile(CONFIG_FILE)
    if not data then return end
    local ok, parsed = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok or not parsed then return end
    for k, v in pairs(parsed) do
        if k == "themeHue" then themeHue = v
        elseif k == "themeIsClear" then themeIsClear = v
        elseif k == "radioVolume" then radioVolume = v
        elseif k == "radioLoop" then radioLoop = v
        elseif settings[k] ~= nil then settings[k] = v end
    end
end

local function SaveRadio()
