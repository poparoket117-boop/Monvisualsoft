-- ===== НАСТРОЙКИ =====
local themeHue = 270
local themeIsClear = false
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(0, 0, 0)

local function getThemeColor() return Color3.fromRGB(20, 20, 30) end
local function getAccentColor()
    if themeIsClear then return WHITE end
    return Color3.fromHSV(themeHue / 360, 0.7, 0.9)
end
local function getTransparency()
    if themeIsClear then return 0.7 end
    return 0.85
end

local settings = {
    chamsEnabled = false,
    boxEspEnabled = false,
    skeletonEspEnabled = false,
    mm2ChamsEnabled = false,
}

local CONFIG_FILE = "MonCombat_config.json"
local hasFileApi = (writefile ~= nil) and (readfile ~= nil) and (isfile ~= nil)
local function _writefile(n, d) if hasFileApi then pcall(writefile, n, d) end end
local function _readfile(n)
    if hasFileApi then
        local ok, d = pcall(readfile, n)
        if ok then return d end
    end
    return nil
end

local function SaveConfig()
    local data = {}
    for k, v in pairs(settings) do data[k] = v end
    data.themeHue = themeHue
    data.themeIsClear = themeIsClear
    _writefile(CONFIG_FILE, HttpService:JSONEncode(data))
end

local function LoadConfig()
    local data = _readfile(CONFIG_FILE)
    if not data then return end
    local ok, parsed = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok or not parsed then return end
    themeHue = parsed.themeHue or themeHue
    themeIsClear = parsed.themeIsClear or themeIsClear
    for k, v in pairs(parsed) do
        if settings[k] ~= nil then settings[k] = v end
    end
end
LoadConfig()

-- ===================== CHAMS =====================
local chamsHighlights = {}

local function RemoveChams(player)
    if chamsHighlights[player] then
        pcall(function() chamsHighlights[player]:Destroy() end)
        chamsHighlights[player] = nil
    end
end

local function CreateChams(player, character)
    if player == Player then return end
    RemoveChams(player)
    local hl = Instance.new("Highlight")
    hl.Name = "MonCombat_Chams"
    hl.Adornee = character
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = getAccentColor()
    hl.FillTransparency = 0.35
    hl.OutlineColor = BLACK
    hl.OutlineTransparency = 0
    hl.Parent = character
    chamsHighlights[player] = hl
end

local function SetupChamsPlayer(player)
    if player == Player then return end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        if settings.chamsEnabled then CreateChams(player, char) end
    end)
    if player.Character and settings.chamsEnabled then
        CreateChams(player, player.Character)
    end
end

local function ApplyChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            if settings.chamsEnabled and p.Character then
                CreateChams(p, p.Character)
            else
                RemoveChams(p)
            end
        end
    end
end

