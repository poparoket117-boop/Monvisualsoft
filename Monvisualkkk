local function CreateSkeleton(player, character)
    if player == Player then return end
    if Skeletons[player] then
        for _, line in ipairs(Skeletons[player].Lines) do
            pcall(function() line:Destroy() end)
        end
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local bones = (humanoid.RigType == Enum.HumanoidRigType.R15) and R15Bones or R6Bones
    local lines = {}
    for _ = 1, #bones do
        table.insert(lines, MakeSkelLine())
    end

    Skeletons[player] = {
        Character = character,
        Lines = lines,
        Bones = bones
    }
end

local function RemoveSkeleton(player)
    if Skeletons[player] then
        for _, line in ipairs(Skeletons[player].Lines) do
            pcall(function() line:Destroy() end)
        end
        Skeletons[player] = nil
    end
