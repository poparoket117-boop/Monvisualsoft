    hl.OutlineColor = BLACK
    hl.OutlineTransparency = 0
    hl.Parent = character
    chamsHighlights[player] = hl
end

local function SetupChamsPlayer(player)
    if player == Player then return end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        if settings.chamsEnabled then CreateChams(player, char) end
    end)
    if player.Character and settings.chamsEnabled then
        CreateChams(player, player.Character)
    end
end

local function ApplyChams()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            if settings.chamsEnabled and p.Character then
                CreateChams(p, p.Character)
            else
                RemoveChams(p)
            end
        end
    end
end

