local function ClearAnimTracks()
    for _, t in pairs(AnimTracks) do
        if t then
            pcall(function() t:Stop(0) t:Destroy() end)
        end
    end
    AnimTracks = {}
end

local function StopAllOther(hum)
    if not hum then return end
    for _, track in pairs(hum:GetPlayingAnimationTracks()) do
        local isOurs = false
        for _, our in pairs(AnimTracks) do
            if our == track then isOurs = true break end
        end
        if not isOurs then
            pcall(function() track:Stop(0) end)
        end
    end
end

local function LoadAnimTracks(pack)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    ClearAnimTracks()

    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end

    local function make(id, prio)
        if not id or id == "" then return nil end
        local cleanId = tostring(id):gsub("%D", "")
        if cleanId == "" then return nil end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. cleanId
        local ok, track = pcall(function()
            return animator:LoadAnimation(a)
        end)
        if ok and track then
            track.Priority = prio
            track.Looped = true
            return track
        end
        return nil
    end

    AnimTracks.Idle     = make(pack.idle, Enum.AnimationPriority.Idle)
    AnimTracks.Walk     = make(pack.walk, Enum.AnimationPriority.Movement)
    AnimTracks.Run      = make(pack.run,  Enum.AnimationPriority.Movement)
    AnimTracks.Jump     = make(pack.jump, Enum.AnimationPriority.Action)
    AnimTracks.Fall     = make(pack.fall, Enum.AnimationPriority.Action)
    AnimTracks.Climb    = make(pack.climb, Enum.AnimationPriority.Action)
    AnimTracks.Swim     = make(pack.swim, Enum.AnimationPriority.Movement)
    AnimTracks.SwimIdle = make(pack.swimidle or pack.idle, Enum.AnimationPriority.Idle)
end

local animLastName, animLastTime = nil, 0

local function PlayAnim(name)
    local track = AnimTracks[name]
    if track and track.IsPlaying then
        if track.TimePosition == animLastTime and name == animLastName then
            pcall(function() track:Stop(0) track:Play(0.1) end)
        end
        animLastTime = track.TimePosition
        animLastName = name
        return
    end
    animLastName = name
    animLastTime = 0
    for n, t in pairs(AnimTracks) do
        if t then
            if n == name then
                pcall(function() t:Play(0.15) t:AdjustSpeed(1) end)
            else
                if t.IsPlaying then pcall(function() t:Stop(0.1) end) end
            end
        end
    end
end

local function AnimUpdate()
    local char = Player.Character
    if not char or not CurrentAnimPack then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    StopAllOther(hum)

    local animate = char:FindFirstChild("Animate")
    if animate then pcall(function() animate.Disabled = true animate:Destroy() end) end

    local state = hum:GetState()
    local speed = 0
    if hum.RootPart then
        speed = hum.RootPart.AssemblyLinearVelocity.Magnitude
    end

    if state == Enum.HumanoidStateType.Jumping then
        PlayAnim("Jump")
    elseif state == Enum.HumanoidStateType.Freefall then
        PlayAnim("Fall")
    elseif state == Enum.HumanoidStateType.Climbing then
        PlayAnim("Climb")
    elseif state == Enum.HumanoidStateType.Swimming then
        PlayAnim(speed > 1 and "Swim" or "SwimIdle")
    else
        if speed > 1.5 then
            PlayAnim(speed > 14 and "Run" or "Walk")
        else
            PlayAnim("Idle")
        end
    end
end

function ApplyAnimPack(pack, packName)
    if not pack then return end
    CurrentAnimPack = pack
    animLastName = nil
    local char = Player.Character
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    local animate = char:FindFirstChild("Animate")
    if animate then pcall(function() animate.Disabled = true animate:Destroy() end) end

    for _, t in pairs(hum:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop(0) end)
    end

    task.wait(0.2)
    LoadAnimTracks(pack)

    if AnimConn then AnimConn:Disconnect() AnimConn = nil end
    AnimConn = RunService.RenderStepped:Connect(AnimUpdate)

    if packName then
        _writefile(ANIM_FILE, HttpService:JSONEncode({ name = packName, pack = pack }))
    end
end

function ResetAnimations()
    if AnimConn then AnimConn:Disconnect() AnimConn = nil end
    ClearAnimTracks()
    CurrentAnimPack = nil
    animLastName = nil

    _delfile(ANIM_FILE)

    local char = Player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, t in pairs(hum:GetPlayingAnimationTracks()) do
                pcall(function() t:Stop(0) end)
            end
        end
        if not char:FindFirstChild("Animate") then
            local animate = game:GetService("StarterPlayer").StarterCharacterScripts:FindFirstChild("Animate")
            if animate then
                local newAnimate = animate:Clone()
                newAnimate.Parent = char
            end
        else
            local animate = char:FindFirstChild("Animate")
            if animate then animate.Disabled = false end
        end
    end
end

