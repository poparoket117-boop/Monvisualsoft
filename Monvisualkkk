local function playWastedEffect(character)
    if wastedEffectRunning then return end
    wastedEffectRunning = true
    if wastedSound then wastedSound:Play() end
    if wastedColorCorrection then
        wastedColorCorrection.Enabled = true
        wastedColorCorrection.Saturation = -1
        wastedColorCorrection.Contrast = 1.2
        wastedColorCorrection.Brightness = -0.25
    end
    if wastedBlur then
        wastedBlur.Enabled = true
        wastedBlur.Size = 0
    end
    if wastedBlackFrame then
        TweenService:Create(wastedBlackFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.4}):Play()
    end
    if wastedBandFrame then
        TweenService:Create(wastedBandFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.35}):Play()
    end
    if wastedBlur then
        task.delay(0.2, function()
            TweenService:Create(wastedBlur, TweenInfo.new(0.8, Enum.EasingStyle.Sine), {Size = 24}):Play()
        end)
    end
    task.wait(0.2)
    if wastedLabel then
        TweenService:Create(wastedLabel, TweenInfo.new(0.5, Enum.EasingStyle.Back), {TextTransparency = 0}):Play()
    end
    local startTime = tick()
    local duration = 3.5
    if wastedConnection then wastedConnection:Disconnect() end
    wastedConnection = RunService.RenderStepped:Connect(function()
        local elapsed = tick() - startTime
        if elapsed > duration then
            if wastedConnection then wastedConnection:Disconnect() wastedConnection = nil end
            return
        end
        if not character or not character.Parent then return end
        local root = character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("Head")
        if not root then return end
        local t = math.clamp(elapsed / duration, 0, 1)
        local eased = 1 - (1 - t) * (1 - t)
        local height = eased * 12
        local angle = elapsed * 0.55
        local radius = 8 + eased * 4
        local focus = root.Position
        local offset = Vector3.new(math.sin(angle) * radius, height + 3, math.cos(angle) * radius)
        Camera.CFrame = CFrame.new(focus + offset, focus)
        Camera.Focus = CFrame.new(focus)
    end)
    task.delay(duration + 0.2, function()
        if wastedConnection then wastedConnection:Disconnect() wastedConnection = nil end
        resetWastedEffect()
        wastedEffectRunning = false
    end)
end

