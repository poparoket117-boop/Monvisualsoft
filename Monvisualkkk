local function playRadioIndex(index)
    if #radioSongs == 0 then return end
    if index < 1 then index = #radioSongs end
    if index > #radioSongs then index = 1 end
    radioCurrentIndex = index
    stopRadio()
    local song = radioSongs[index]
    radioSound = Instance.new("Sound")
    radioSound.Name = "MonvisualRadioSound"
    radioSound.SoundId = "rbxassetid://" .. tostring(song.id)
    radioSound.Volume = radioVolume
    radioSound.Looped = false
    radioSound.Parent = SoundService
    radioSound:Play()
    radioIsPlaying = true
    radioSound.Ended:Connect(function()
        if not radioIsPlaying then return end
        if radioLoop then
            playRadioIndex(radioCurrentIndex)
        else
            if radioCurrentIndex < #radioSongs then
                playRadioIndex(radioCurrentIndex + 1)
            else
                stopRadio()
            end
        end
    end)
end

local function toggleRadioPlay()
    if radioIsPlaying then
        stopRadio()
    else
        if #radioSongs > 0 then
            playRadioIndex(radioCurrentIndex > 0 and radioCurrentIndex or 1)
        end
    end
end

