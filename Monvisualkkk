local themeHue = 270
local themeIsClear = false
local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(0, 0, 0)

local function getThemeColor() return Color3.fromRGB(20, 20, 30) end
local function getAccentColor()
    if themeIsClear then return WHITE end
    return Color3.fromHSV(themeHue / 360, 0.7, 0.9)
end
local function getTransparency()
    if themeIsClear then return 0.7 end
    return 0.85
end

local settings = {
    chamsEnabled = false,
    boxEspEnabled = false,
    skeletonEspEnabled = false,
    mm2ChamsEnabled = false,
    animEnabled = false,
}

local CONFIG_FILE = "MonCombat_config.json"
local hasFileApi = (writefile ~= nil) and (readfile ~= nil) and (isfile ~= nil)
local function _writefile(n, d) if hasFileApi then pcall(writefile, n, d) end end
local function _readfile(n)
    if hasFileApi then
        local ok, d = pcall(readfile, n)
        if ok then return d end
    end
    return nil
end

local Favorites = getgenv().AnimFavorites or {}
getgenv().AnimFavorites = Favorites
local CustomPacks = getgenv().AnimCustomPacks or {}
getgenv().AnimCustomPacks = CustomPacks
local Overrides = getgenv().AnimOverrides or {}
getgenv().AnimOverrides = Overrides

local function SaveConfig()
    local data = {}
    for k, v in pairs(settings) do data[k] = v end
    data.themeHue = themeHue
    data.themeIsClear = themeIsClear
    data.favorites = Favorites
    data.customPacks = CustomPacks
    data.overrides = Overrides
    _writefile(CONFIG_FILE, HttpService:JSONEncode(data))
end

local function LoadConfig()
    local data = _readfile(CONFIG_FILE)
    if not data then return end
    local ok, parsed = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok or not parsed then return end
    themeHue = parsed.themeHue or themeHue
    themeIsClear = parsed.themeIsClear or themeIsClear
    for k, v in pairs(parsed) do
        if settings[k] ~= nil then settings[k] = v end
    end
    if parsed.favorites then for k, v in pairs(parsed.favorites) do Favorites[k] = v end end
    if parsed.customPacks then
        for k, v in pairs(parsed.customPacks) do
            CustomPacks[k] = v
        end
    end
    if parsed.overrides then for k, v in pairs(parsed.overrides) do Overrides[k] = v end end
end
LoadConfig()

-- ===================== ANIMATION CORE =====================
local CurrentPack = nil
local Tracks = {}
local AnimConn = nil

local function ClearTracks()
    for _, t in pairs(Tracks) do
        if t then pcall(function() t:Stop(0) t:Destroy() end) end
    end
    Tracks = {}
end

local function StopAllOther(hum)
    if not hum then return end
    for _, track in pairs(hum:GetPlayingAnimationTracks()) do
        local isOurs = false
        for _, our in pairs(Tracks) do
            if our == track then isOurs = true break end
        end
        if not isOurs then pcall(function() track:Stop(0) end) end
    end
end

local function LoadTracks(pack)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    ClearTracks()

    local function make(id, prio)
        if not id or id == "" then return nil end
        local cleanId = tostring(id):gsub("%D", "")
        if cleanId == "" then return nil end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. cleanId
        local ok, track = pcall(function() return hum:LoadAnimation(a) end)
        if ok and track then
            track.Priority = prio
            track.Looped = true
            return track
        end
        return nil
    end

    Tracks.Idle     = make(pack.idle, Enum.AnimationPriority.Idle)
    Tracks.Walk     = make(pack.walk, Enum.AnimationPriority.Movement)
    Tracks.Run      = make(pack.run,  Enum.AnimationPriority.Movement)
    Tracks.Jump     = make(pack.jump, Enum.AnimationPriority.Action)
    Tracks.Fall     = make(pack.fall, Enum.AnimationPriority.Action)
    Tracks.Climb    = make(pack.climb, Enum.AnimationPriority.Action)
    Tracks.Swim     = make(pack.swim, Enum.AnimationPriority.Movement)
    Tracks.SwimIdle = make(pack.swimidle or pack.idle, Enum.AnimationPriority.Idle)
end

local lastName, lastTime = nil, 0

local function PlayAnim(name)
    local track = Tracks[name]
    if track and track.IsPlaying then
        if track.TimePosition == lastTime and name == lastName then
            pcall(function() track:Stop(0) track:Play(0.1) end)
        end
        lastTime = track.TimePosition
        lastName = name
        return
    end
    lastName, lastTime = name, 0
    for n, t in pairs(Tracks) do
        if t then
            if n == name then
                pcall(function() t:Play(0.15) t:AdjustSpeed(1) end)
            elseif t.IsPlaying then
                pcall(function() t:Stop(0.1) end)
            end
        end
    end
end

local function UpdateAnim()
    local char = Player.Character
    if not char or not CurrentPack then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    StopAllOther(hum)

    local animate = char:FindFirstChild("Animate")
    if animate then
        pcall(function() animate.Disabled = true animate:Destroy() end)
    end

    local state = hum:GetState()
    local speed = 0
    if hum.RootPart then speed = hum.RootPart.AssemblyLinearVelocity.Magnitude end

    if state == Enum.HumanoidStateType.Jumping then
        PlayAnim("Jump")
    elseif state == Enum.HumanoidStateType.Freefall then
        PlayAnim("Fall")
    elseif state == Enum.HumanoidStateType.Climbing then
        PlayAnim("Climb")
    elseif state == Enum.HumanoidStateType.Swimming then
        PlayAnim(speed > 1 and "Swim" or "SwimIdle")
    else
        if speed > 1.5 then
            PlayAnim(speed > 14 and "Run" or "Walk")
        else
            PlayAnim("Idle")
        end
    end
end

local function ApplyPack(pack)
    if not pack then return end
    CurrentPack = pack
    lastName = nil

    local char = Player.Character
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    local animate = char:FindFirstChild("Animate")
    if animate then
        pcall(function() animate.Disabled = true animate:Destroy() end)
    end

    for _, t in pairs(hum:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop(0) end)
    end

    task.wait(0.2)
    LoadTracks(pack)

    if AnimConn then AnimConn:Disconnect() AnimConn = nil end
    AnimConn = RunService.RenderStepped:Connect(UpdateAnim)
end

local function ResetAnimations()
    if AnimConn then AnimConn:Disconnect() AnimConn = nil end
    ClearTracks()
    CurrentPack = nil
    lastName = nil

    local char = Player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, t in pairs(hum:GetPlayingAnimationTracks()) do
                pcall(function() t:Stop(0) end)
            end
        end
        if not char:FindFirstChild("Animate") then
            local animate = StarterPlayer.StarterCharacterScripts:FindFirstChild("Animate")
            if animate then animate:Clone().Parent = char end
        else
            char:FindFirstChild("Animate").Disabled = false
        end
    end
end

