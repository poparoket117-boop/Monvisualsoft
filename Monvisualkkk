    desc.TextXAlignment = Enum.TextXAlignment.Left

    local toggle = Instance.new("TextButton", card)
    toggle.Size = UDim2.new(0, 22, 0, 12)
    toggle.Position = UDim2.new(1, -26, 0, 6)
    toggle.BackgroundColor3 = WHITE
