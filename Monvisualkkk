    end
    for n, b in pairs(Tabs) do
        if b.BackgroundColor3 ~= Color3.fromRGB(40, 40, 52) then
            b.BackgroundColor3 = getAccentColor()
        end
    end
end

local function makeThemeButton(parent, name, hue, isClear)
    local card = Instance.new("Frame", parent)
    card.Size = UDim2.new(1, 0, 0, 55)
    card.BackgroundColor3 = isClear and Color3.fromRGB(200, 200, 200) or Color3.fromHSV(hue / 360, 0.7, 0.9)
    card.BackgroundTransparency = 0.2
    card.BorderSizePixel = 0
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    local st = Instance.new("UIStroke", card)
    st.Color = getAccentColor()
    st.Thickness = 1

    local title = Instance.new("TextLabel", card)
    title.Size = UDim2.new(1, -70, 0, 20)
    title.Position = UDim2.new(0, 12, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = name
    title.TextColor3 = isClear and BLACK or WHITE
    title.TextSize = 14
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left

    local desc = Instance.new("TextLabel", card)
    desc.Size = UDim2.new(1, -70, 0, 16)
    desc.Position = UDim2.new(0, 12, 0, 28)
    desc.BackgroundTransparency = 1
    desc.Text = isClear and "белая тема" or "акцентный цвет"
    desc.TextColor3 = isClear and Color3.fromRGB(40, 40, 50) or Color3.fromRGB(230, 230, 240)
    desc.TextSize = 10
    desc.Font = Enum.Font.Gotham
    desc.TextXAlignment = Enum.TextXAlignment.Left

    local apply = Instance.new("TextButton", card)
    apply.Size = UDim2.new(0, 60, 0, 30)
    apply.Position = UDim2.new(1, -70, 0.5, -15)
    apply.BackgroundColor3 = BLACK
    apply.Text = "Apply"
    apply.TextColor3 = WHITE
    apply.Font = Enum.Font.GothamBold
    apply.TextSize = 12
    apply.BorderSizePixel = 0
    apply.AutoButtonColor = false
    Instance.new("UICorner", apply).CornerRadius = UDim.new(0, 6)

    apply.MouseButton1Click:Connect(function()
        if isClear then
            themeIsClear = true
        else
            themeIsClear = false
            themeHue = hue
        end
        refreshTheme()
        SaveConfig()
        apply.BackgroundColor3 = getAccentColor()
        apply.TextColor3 = BLACK
        task.wait(0.3)
        apply.BackgroundColor3 = BLACK
        apply.TextColor3 = WHITE
    end)
end

