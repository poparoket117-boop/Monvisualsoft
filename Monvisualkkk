                f.callback(newState)
                if newState then
                    toggle.BackgroundColor3 = BLACK
                    toggle.Text = "ON"
                    toggle.TextColor3 = WHITE
                else
                    toggle.BackgroundColor3 = WHITE
                    toggle.Text = "OFF"
                    toggle.TextColor3 = BLACK
                end
                SaveConfig()
            end
        end)
    end
    task.wait()
    CardContainer.CanvasSize = UDim2.new(0, 0, 0, cardLayout.AbsoluteContentSize.Y + 10)
end

