    if OpenBtn then
        OpenBtn.BackgroundTransparency = 0
        OpenBtn.BackgroundColor3 = BLACK
    end

    if auraLight and settings.auraColorUseTheme then
        auraLight.Color = accent
    end

    for _, card in ipairs(CardContainer:GetChildren()) do
        if card:IsA("Frame") then
            card.BackgroundTransparency = trans
            for _, child in ipairs(card:GetChildren()) do
                if child:IsA("UIStroke") then child.Color = accent
                elseif child:IsA("TextButton") and child.Text == "S" then child.BackgroundColor3 = accent
                elseif child:IsA("TextButton") and (child.Text == "OFF" or child.Text == "ON") then
                    if child.Text == "ON" then
                        child.BackgroundColor3 = BLACK
                    else
                        child.BackgroundColor3 = WHITE
                    end
                end
            end
        end
    end
end

